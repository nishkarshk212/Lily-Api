# Lily-Api Configuration
# Copy this file to .env and fill in your private credentials

# Secret API Key for authentication (Passed via header 'x-api-key: your_secret_key')
API_KEY=your_secret_api_key_here

# Service name displayed in health check (GET /)
SERVICE_NAME=lily-api-resolver

# Optional: Port when running FastAPI server locally
PORT=8000
